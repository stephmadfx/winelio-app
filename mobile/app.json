{
  "expo": {
    "name": "Winelio",
    "slug": "winelio",
    "version": "1.0.5",
    "icon": "./assets/images/icon.png",
    "orientation": "portrait",
    "scheme": "winelio",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.winelio.mobile",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Winelio utilise l’appareil photo pour joindre une image ou mettre à jour votre profil.",
        "NSPhotoLibraryUsageDescription": "Winelio accède à vos photos uniquement lorsque vous choisissez une image à joindre.",
        "NSLocationWhenInUseUsageDescription": "Winelio utilise votre position pour proposer les professionnels pertinents autour de vous.",
        "UIBackgroundModes": [
          "remote-notification"
        ]
      },
      "entitlements": {
        "aps-environment": "production"
      },
      "buildNumber": "12",
      "associatedDomains": [
        "applinks:winelio.app"
      ],
      "appleTeamId": "QTG533MH6L"
    },
    "android": {
      "package": "app.winelio.mobile",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "CAMERA",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#F8F9FA"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": true,
      "versionCode": 16,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "winelio.app",
              "pathPrefix": "/network"
            },
            {
              "scheme": "https",
              "host": "winelio.app",
              "pathPrefix": "/dashboard"
            },
            {
              "scheme": "https",
              "host": "winelio.app",
              "pathPrefix": "/wallet"
            },
            {
              "scheme": "https",
              "host": "winelio.app",
              "pathPrefix": "/messages"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/adaptive-icon.png",
          "color": "#FF6B35"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-logo.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#F8F9FA",
          "dark": {
            "backgroundColor": "#0F172A"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {}
    }
  }
}
